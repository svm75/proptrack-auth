# Copy to deploy/.env and fill in real values on the NAS itself. Never commit the filled-in file.
#
# SECRETS (must be supplied — do not leave blank, do not reuse example values):
#   PGPASSWORD      — the proptrack_app Postgres role's password
#   API_AUTH_TOKEN  — shared bearer token; generate a fresh one with: openssl rand -base64 32
#
# DEPLOYMENT-SPECIFIC (not secret, but must be set to this deployment's real values):
#   ALLOWED_ORIGIN  — this deployment's actual origin(s), comma-separated (Tailscale origin)
#
# NAS-SPECIFIC (has a sensible default, override only if this NAS differs):
#   DOCUMENTS_HOST_PATH
#
# Google Drive/OAuth has been fully removed from this deployment (zero attachment records
# reference it in production) — no Google-related variables remain here.

PGHOST=mfa-ds925.tailc096cf.ts.net
PGPORT=5433
PGDATABASE=myplatform
PGSCHEMA=proptrack
PGUSER=proptrack_app
PGPASSWORD=
API_AUTH_TOKEN=
ALLOWED_ORIGIN=
# NAS-native document storage. Host-side directory bind-mounted into
# the api container at /app/data/documents. Must exist on the NAS (created + permissioned by an
# operator with NAS filesystem access) before `docker compose up` — see deploy/README.md
# "Document storage setup". Default below matches the App root convention (/App/PropTracker/).
DOCUMENTS_HOST_PATH=/App/PropTracker/Documents
