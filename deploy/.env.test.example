# Copy to deploy/.env on the TEST deployment (/volume1/docker/proptracker-test/deploy/.env),
# never on the production one. Never commit the filled-in file. Same shape as deploy/.env.example
# — see that file's comments for what's a secret vs. deployment-specific vs. defaultable — plus
# the four vars below that separate this deployment from production on the same NAS.

# The LAN IP, not the Tailscale hostname — containers on this NAS can't resolve Tailscale
# MagicDNS names from inside their own network namespace (confirmed twice: production hit this
# exact error first, ENOTFOUND on the Tailscale hostname; see migration.md).
PGHOST=192.168.1.25
PGPORT=5433
PGDATABASE=proptrack_test
PGSCHEMA=proptrack
PGUSER=proptrack_test_app
PGPASSWORD=
API_AUTH_TOKEN=
ALLOWED_ORIGIN=https://mfa-ds925.tailc096cf.ts.net:9083
DOCUMENTS_HOST_PATH=/volume1/App/PropTracker/Documents-test

# Separates this stack from the production one (container names, Compose project name, Caddy's
# published port) so both can run on the same NAS at once without colliding. Production port is
# 8083; test uses production + 1000, i.e. 9083 — the same convention future test deployments of
# other apps on this NAS (TripOrganiser, wealth-ledger) would use if/when they add one.
COMPOSE_PROJECT_NAME=proptracker-test
CONTAINER_PREFIX=proptrack-test
CADDY_PORT=9083
