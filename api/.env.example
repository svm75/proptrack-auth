# Copy to .env and fill in real values (never commit the filled-in file).
PGHOST=
PGPORT=5433
PGDATABASE=myplatform
PGSCHEMA=proptrack
PGUSER=proptrack_app
PGPASSWORD=
PGPOOL_MAX=5
API_PORT=8787
API_AUTH_TOKEN=
ALLOWED_ORIGIN=
# NAS-native document storage — relative or absolute path to the documents root.
# Production: /app/data/documents (container bind-mount to /App/PropTracker/Documents/ on the
# NAS host — see deploy/docker-compose.yml). Local dev default: ./data/documents-dev
DOCUMENTS_ROOT=./data/documents-dev
