# Copy to .env and fill in real values (never commit the filled-in file).
#
# A dedicated test database/role exists for local development and testing, isolated from
# production: PGDATABASE=proptrack_test, PGUSER=proptrack_test_app (same schema name and
# structure as production — db/001-007 applied). Point this file at the test database rather
# than PGDATABASE=myplatform/PGUSER=proptrack_app for day-to-day development; use the production
# values only for a deliberate, explicitly-authorized production task.
PGHOST=
PGPORT=5433
PGDATABASE=proptrack_test
PGSCHEMA=proptrack
PGUSER=proptrack_test_app
PGPASSWORD=
PGPOOL_MAX=5
API_PORT=8787
API_AUTH_TOKEN=
ALLOWED_ORIGIN=
# NAS-native document storage — relative or absolute path to the documents root.
# Production: /app/data/documents (container bind-mount to /App/PropTracker/Documents/ on the
# NAS host — see deploy/docker-compose.yml). Local dev default: ./data/documents-dev
DOCUMENTS_ROOT=./data/documents-dev
